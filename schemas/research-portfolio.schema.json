{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"SIcologist Research Program Portfolio",
  "type":"object",
  "required":["version","title","policy","programs","allocation","boundaries","fingerprint"],
  "properties":{
    "version":{"const":"RESEARCH_PORTFOLIO_V0.1"},
    "programs":{"type":"array","minItems":1},
    "fingerprint":{"type":"string","pattern":"^[a-f0-9]{64}$"}
  }
}