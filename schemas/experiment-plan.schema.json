{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"SIcologist Experiment Plan",
  "type":"object",
  "required":["planId","version","control","arms"],
  "properties":{
    "planId":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "version":{"type":"string"},
    "control":{"const":"UNCHANGED_REPLAY"},
    "arms":{
      "type":"array",
      "items":{
        "type":"object",
        "required":["armId","targetCondition","probeId","probe","alternativesRetained"]
      }
    }
  }
}
