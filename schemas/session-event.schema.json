{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"SIcologist Session Event",
  "type":"object",
  "required":["type"],
  "additionalProperties":false,
  "properties":{
    "seq":{"type":"integer","minimum":1},
    "id":{"type":"string"},
    "type":{"enum":["PROMPT","RESPONSE","TOOL_CALL","TOOL_RESULT","MEMORY_READ","MEMORY_WRITE","ROLE_CHANGE","CHALLENGE","ERROR","RETRY","INTERVENTION","RECOVERY"]},
    "at":{"type":"string"},
    "actor":{"type":"string"},
    "content":{"type":"string"},
    "tool":{"type":"string"},
    "status":{"type":"string"},
    "role":{"type":"string"},
    "authorized":{"type":"boolean"},
    "roleViolation":{"type":"boolean"},
    "memoryTrusted":{"type":"boolean"},
    "challengeAccepted":{"type":"boolean"},
    "confidence":{"$ref":"#/$defs/metric"},
    "goalAlignment":{"$ref":"#/$defs/metric"},
    "contextLoad":{"$ref":"#/$defs/metric"},
    "recoveryDelta":{"type":"number","minimum":-1,"maximum":1},
    "claims":{
      "type":"array",
      "items":{
        "type":"object",
        "required":["text","supported"],
        "additionalProperties":false,
        "properties":{"text":{"type":"string"},"supported":{"type":"boolean"}}
      }
    },
    "metadata":{"type":"object"}
  },
  "$defs":{"metric":{"type":"number","minimum":0,"maximum":1}}
}
