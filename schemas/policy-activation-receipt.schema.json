{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"SIcologist Policy Activation Receipt",
  "type":"object",
  "required":["version","promotionProposalFingerprint","activePolicyStateFingerprint","activePolicyFingerprint","rollbackPolicyFingerprint","operatorApproved","approvalReceipt","experimentExecutionAuthorized","fingerprint"],
  "properties":{
    "version":{"const":"POLICY_ACTIVATION_RECEIPT_V0.1"},
    "operatorApproved":{"const":true},
    "experimentExecutionAuthorized":{"const":false},
    "fingerprint":{"type":"string","pattern":"^[a-f0-9]{64}$"}
  }
}