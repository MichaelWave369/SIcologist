{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"SIcologist Adaptive Campaign Revision",
  "type":"object",
  "required":["version","revisionNumber","rootPlanFingerprint","supersedesPlanFingerprint","supersedesRevisionFingerprint","priorTrackerFingerprint","revisionReason","triggers","assessmentTransition","retiredCompletedCandidates","allowRetestCompleted","planDiff","nextPlan","activation","boundaries","fingerprint"],
